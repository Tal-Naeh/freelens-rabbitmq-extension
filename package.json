{
  "name": "@freelensapp/rabbitmq-extension",
  "version": "0.1.6",
  "description": "Freelens extension for RabbitMQ — cluster-native queue, exchange, connection and message inspection",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tal-Naeh/freelens-rabbitmq-extension.git",
    "directory": "."
  },
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/**/*"
  ],
  "engines": {
    "node": ">= 22.0.0",
    "freelens": "^1.8.0"
  },
  "copyright": "© 2026 Freelens Authors",
  "license": "MIT",
  "author": {
    "name": "Tal Naeh"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.5.1",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm biome:check",
    "lint:fix": "pnpm biome:fix",
    "knip": "pnpm dlx knip@6.15.0 --dependencies --no-gitignore",
    "knip:check": "pnpm clean:out && pnpm \"/^knip:(development|production)\\$/\"",
    "knip:development": "pnpm knip",
    "knip:production": "pnpm knip --production --strict",
    "test:unit": "vitest run",
    "smoke:main": "node scripts/smoke-main.cjs",
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "prebuild": "pnpm type:check",
    "build": "electron-vite build && pnpm smoke:main",
    "build:production": "VITE_PRESERVE_MODULES=false electron-vite build && pnpm smoke:main",
    "build:force": "electron-vite build",
    "prepack": "pnpm build && pnpm clean:tgz",
    "bump-version": "pnpm version --no-commit-hooks --no-git-tag-version",
    "pack:dev": "pnpm bump-version prerelease && pnpm build && pnpm clean:tgz && pnpm pack && pnpm dlx shx@0.4.0 ls \"$PWD/*.tgz\"",
    "clean": "pnpm clean:out",
    "clean:node_modules": "pnpm dlx shx@0.4.0 rm -rf node_modules",
    "clean:out": "pnpm dlx shx@0.4.0 rm -rf out",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\"",
    "clean:all": "pnpm \"/^clean:(node_modules|out|tgz)\\$/\"",
    "rabbitmq:up": "docker compose -f test/e2e/docker-compose.yml up -d --wait",
    "rabbitmq:down": "docker compose -f test/e2e/docker-compose.yml down -v",
    "itest": "node --import tsx test/e2e/integration.local.ts"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@freelensapp/extensions": "^1.10.3",
    "@kubernetes/client-node": "^1.4.0",
    "@types/node": "~24.12.4",
    "@types/react": "^17.0.91",
    "@vitejs/plugin-react": "^6.0.1",
    "electron-vite": "^5.0.0",
    "encoding": "^0.1.13",
    "react": "17.0.2",
    "sass": "^1.99.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-sass-dts": "^1.3.37",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens",
    "rabbitmq",
    "amqp"
  ],
  "packageManager": "pnpm@10.33.4"
}
